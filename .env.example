# MongoDB connection string (Atlas or local), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mindcare?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWT session tokens. Generate with: openssl rand -base64 48
JWT_SECRET=

# Google OAuth Client ID/Secret from Google Cloud Console (APIs & Services > Credentials).
# Authorized redirect URI must be <your-app-origin>/api/auth/google/callback
# (e.g. http://localhost:3000/api/auth/google/callback for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend API key for sending password-reset emails. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address for reset emails. "onboarding@resend.dev" works out of the box without
# verifying a domain, but Resend will only let it deliver to the email address on your
# Resend account until you verify your own sending domain.
EMAIL_FROM=onboarding@resend.dev
