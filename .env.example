# MongoDB connection string (Atlas or local), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mindcare?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWT session tokens. Generate with: openssl rand -base64 48
JWT_SECRET=

# Google OAuth Client ID/Secret from Google Cloud Console (APIs & Services > Credentials).
# Authorized redirect URI must be <your-app-origin>/api/auth/google/callback
# (e.g. http://localhost:3000/api/auth/google/callback for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public or deployment base URL (defaults to http://localhost:3000 in development)
APP_URL=http://localhost:3000

# SMTP Email Configuration (e.g. Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=MindCare

# Base URL of the ml-service (see ml-service/README.md) serving the trained
# emotion/mental-health-status models. Defaults to http://127.0.0.1:8000 if unset.
ML_SERVICE_URL=http://127.0.0.1:8000

# Gemini API key used to generate therapy chat replies (non-crisis messages only).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
